# Copy this file to .env.local, then restart Vite or rebuild the site.
# Public inbox used by the contact form and direct email links.
VITE_CONTACT_EMAIL=Gracefulagingllc@gmail.com

# Default: FormSubmit handles delivery and its verification page.
# Activate the inbox using FormSubmit's confirmation email after the first submission.
# Set to email only if you prefer opening the visitor's email app instead.
VITE_CONTACT_DELIVERY=formsubmit

# Optional public HTTPS form endpoint. No API keys or other secrets.
# Receives JSON { name, email, phone, service, message }.
# Must return a 2xx response and JSON { "ok": true } or { "success": true }.
VITE_CONTACT_ENDPOINT=

# Your full public HTTPS website URL, including any repository path.
# GitHub Pages project example: https://YOUR-USERNAME.github.io/YOUR-REPOSITORY
# Used for canonical URLs, social images, and sitemap.xml.
# Leave empty during local development. Never use a placeholder domain in production.
VITE_SITE_URL=

# URL path where the site is hosted; use / for local development or a custom domain.
# For a GitHub Pages project use /YOUR-REPOSITORY/ (matching VITE_SITE_URL).
VITE_BASE_PATH=/
